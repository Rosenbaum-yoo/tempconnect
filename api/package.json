{
  "name": "tempconnect-api",
  "version": "2.0.0",
  "description": "TempConnect B2B SaaS API -- Zeitarbeit-Plattform mit Enterprise-Features",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nodemon --legacy-watch --ignore uploads/ server.js",
    "start": "node server.js",
    "test": "node scripts/run-tests.js --suite=non-integration",
    "test:unit": "node scripts/run-tests.js --suite=non-integration",
    "test:all": "node scripts/run-tests.js --suite=all",
    "test:integration": "node scripts/run-tests.js --suite=integration",
    "test:integration:commercial": "node --test --test-force-exit test/integration/subscription-commerce-http.flow.test.js",
    "test:security": "node scripts/run-tests.js --suite=security",
    "test:tenant": "node scripts/run-tests.js --suite=tenant",
    "test:pilot": "node scripts/run-tests.js --suite=pilot",
    "test:ci": "node scripts/run-tests.js --suite=ci",
    "test:coverage": "c8 node scripts/run-tests.js --suite=non-integration",
    "test:coverage:full": "c8 node scripts/run-tests.js --suite=all",
    "test:coverage:check": "c8 check-coverage",
    "test:coverage:critical": "node scripts/coverage-critical-check.js",
    "test:coverage:report": "c8 report",
    "test:mutation:subscription": "stryker run stryker.subscription.conf.json",
    "perf:smoke": "node scripts/perf-smoke.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "build": "node --check app.js && node --check server.js && tsc --noEmit",
    "audit:check": "node scripts/audit-coverage-check.js",
    "qa": "npm run lint && npm run audit:check && npm run test && npm run build",
    "qa:full": "npm run lint && npm run audit:check && npm run test:coverage && npm run test:coverage:check && npm run build",
    "list-routes": "node scripts/list-routes.js",
    "occ:owner-access": "node scripts/owner-access-cli.js",
    "verify": "npm run lint && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@sentry/node": "^9.47.1",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.20.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.8",
    "pdf-lib": "^1.17.1",
    "pg": "^8.12.0",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.0.0",
    "redis": "^4.6.13",
    "stripe": "^14.14.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@stryker-mutator/core": "^9.6.1",
    "autocannon": "^2.0.1",
    "c8": "^11.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "nodemon": "^3.1.7",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.2.2",
    "typescript": "^5.4.0"
  }
}
