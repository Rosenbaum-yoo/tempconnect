{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "coverageAnalysis": "off",
  "mutate": [
    "services/monatsplanService.js",
    "services/auegService.js"
  ],
  "commandRunner": {
    "command": "node --test --test-force-exit test/monatsplan.test.js test/aueg.test.js"
  },
  "reporters": [
    "clear-text",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/monatsplan/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/monatsplan/mutation.json"
  },
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 90
  },
  "concurrency": "50%",
  "timeoutMS": 60000,
  "incremental": false,
  "cleanTempDir": "always"
}
