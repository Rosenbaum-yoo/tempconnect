{
  "openapi": "3.0.3",
  "info": {
    "title": "TempConnect API",
    "version": "2.0.0",
    "description": "B2B-Workforce-Management-Plattform (Zeitarbeit). Diese Spezifikation wird AUTOMATISCH aus den echten Zod-Validierungs-Schemas generiert (api/openapi/registry.js) — die Request-Bodies sind damit immer deckungsgleich mit der Laufzeit-Validierung (kein Drift). Alle mutierenden Endpunkte erfordern Session-Cookie + x-csrf-token."
  },
  "servers": [
    {
      "url": "/api",
      "description": "TempConnect API (relativ zur Plattform-Domain)"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Registrierung, Login, Passwort"
    },
    {
      "name": "Organizations",
      "description": "Organisationen & Mitglieder"
    },
    {
      "name": "Requisitions",
      "description": "Bedarfe (Stellenanforderungen)"
    },
    {
      "name": "Marketplace",
      "description": "Kapazitäten, Angebote, Deals"
    },
    {
      "name": "Timesheets",
      "description": "Stundenzettel"
    },
    {
      "name": "Billing",
      "description": "Tarife & Zahlung"
    }
  ],
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "tc.sid",
        "description": "Plattform-Session-Cookie (Login via POST /auth/login)."
      },
      "csrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "x-csrf-token",
        "description": "CSRF-Token (GET /csrf) — Pflicht bei allen mutierenden Requests."
      },
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Maschinen-API-Key (Bearer) für Integrationen; Scopes default-deny."
      }
    },
    "schemas": {
      "Pagination": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 50
          },
          "offset": {
            "type": "integer",
            "nullable": true,
            "minimum": 0,
            "default": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "UuidParam": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id"
        ]
      },
      "Register": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "role": {
            "type": "string",
            "enum": [
              "EMPLOYER",
              "SUPPLIER",
              "WORKER"
            ]
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Login": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "OrganizationCreate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "slug": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80,
            "pattern": "^[a-z0-9-]+$"
          },
          "plan": {
            "type": "string",
            "enum": [
              "DEMO",
              "FREE",
              "BASIS",
              "PLUS",
              "PRO",
              "ENTERPRISE"
            ]
          },
          "website": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "string",
                "enum": [
                  ""
                ]
              }
            ]
          },
          "contact_email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "name"
        ]
      },
      "RequisitionCreate": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "location": {
            "type": "string",
            "maxLength": 200
          },
          "start_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "end_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "workers_needed": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "qualification": {
            "type": "string",
            "maxLength": 200
          },
          "urgency": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "budget_per_hour": {
            "type": "number",
            "nullable": true,
            "minimum": 0,
            "maximum": 9999
          }
        },
        "required": [
          "title"
        ]
      },
      "CapacityPostCreate": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "available_from": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "available_to": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "workers_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "qualification": {
            "type": "string",
            "maxLength": 200
          },
          "location": {
            "type": "string",
            "maxLength": 200
          },
          "lat": {
            "type": "number",
            "nullable": true,
            "minimum": -90,
            "maximum": 90
          },
          "lng": {
            "type": "number",
            "nullable": true,
            "minimum": -180,
            "maximum": 180
          }
        },
        "required": [
          "title"
        ]
      },
      "TimesheetSubmit": {
        "type": "object",
        "properties": {
          "deal_id": {
            "type": "string",
            "format": "uuid"
          },
          "week_start": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "hours": {
            "type": "number",
            "nullable": true,
            "minimum": 0,
            "maximum": 168
          },
          "notes": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "deal_id",
          "week_start",
          "hours"
        ]
      },
      "InvoiceCreate": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "org_id": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "amount": {
            "type": "number",
            "nullable": true,
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3,
            "default": "EUR"
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "due_days": {
            "type": "integer",
            "nullable": true,
            "minimum": 0,
            "maximum": 365,
            "default": 30
          }
        },
        "required": [
          "amount"
        ]
      },
      "PaymentCheckout": {
        "type": "object",
        "properties": {
          "plan": {
            "type": "string",
            "enum": [
              "BASIS",
              "PLUS",
              "PRO"
            ]
          },
          "payment_method": {
            "type": "string",
            "enum": [
              "demo",
              "stripe",
              "paypal"
            ],
            "default": "demo"
          }
        },
        "required": [
          "plan"
        ]
      },
      "PasswordChange": {
        "type": "object",
        "properties": {
          "current_password": {
            "type": "string",
            "minLength": 1
          },
          "new_password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "current_password",
          "new_password"
        ]
      },
      "InviteMember": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "MEMBER",
              "VIEWER",
              "FINANCE"
            ],
            "default": "MEMBER"
          }
        },
        "required": [
          "email"
        ]
      },
      "DealCreate": {
        "type": "object",
        "properties": {
          "requisition_id": {
            "type": "string",
            "format": "uuid"
          },
          "capacity_post_id": {
            "type": "string",
            "format": "uuid"
          },
          "supplier_id": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "start_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "end_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "workers_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "hourly_rate": {
            "type": "number",
            "nullable": true,
            "minimum": 0,
            "maximum": 9999
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "requisition_id",
          "start_date",
          "end_date",
          "workers_count"
        ]
      },
      "OkResponse": {
        "type": "object",
        "properties": {}
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "VALIDATION"
          },
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "nullable": true
            }
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Registrierung (Unternehmen/Agentur/Worker)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Register"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registriert + eingeloggt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validierungsfehler",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Nicht authentifiziert",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Keine Berechtigung / Org-Boundary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate-Limit erreicht",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Eingeloggt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validierungsfehler",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Nicht authentifiziert",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Keine Berechtigung / Org-Boundary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate-Limit erreicht",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/me/password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Passwort ändern",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "csrfToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordChange"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Passwort geändert",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validierungsfehler",
            "content": {
