    "/requisitions": {
      "get": {
        "tags": ["requisitions"],
        "summary": "List requisitions",
        "parameters": [
          { "name": "org_id", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["DRAFT","PENDING_APPROVAL","APPROVED","OPEN","IN_REVIEW","SHORTLISTED","FILLED","CLOSED","CANCELLED"] } },
          { "name": "urgency", "in": "query", "schema": { "type": "string" } },
          { "name": "mine", "in": "query", "schema": { "type": "boolean" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50, "maximum": 200 } }
        ],
        "responses": {
          "200": {
            "description": "Requisitions list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": { "type": "array", "items": { "$ref": "#/components/schemas/Requisition" } },
                    "total": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["requisitions"],
        "summary": "Create a new requisition (requires requisition.create permission)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "role"],
                "properties": {
                  "title": { "type": "string", "minLength": 3, "maxLength": 200 },
                  "role": { "type": "string" },
                  "description": { "type": "string", "nullable": true },
                  "skill_tags": { "type": "array", "items": { "type": "string" } },
                  "headcount": { "type": "integer", "minimum": 1, "default": 1 },
                  "start_date": { "type": "string", "format": "date" },
                  "end_date": { "type": "string", "format": "date" },
                  "location_city": { "type": "string" },
                  "location_postal": { "type": "string" },
                  "radius_km": { "type": "integer", "minimum": 1, "maximum": 500, "default": 50 },
                  "budget_min_cents": { "type": "integer" },
                  "budget_max_cents": { "type": "integer" },
                  "urgency": { "type": "string", "enum": ["normal", "high", "urgent", "notdienst"], "default": "normal" },
                  "approval_required": { "type": "boolean", "default": false }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Requisition created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Requisition" } } } },
          "403": { "description": "Permission denied" }
        }
      }
    },
    "/requisitions/{id}": {
      "get": {
        "tags": ["requisitions"],
        "summary": "Get requisition by ID",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "Requisition", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Requisition" } } } },
          "404": { "description": "Not found" }
        }
      },
      "patch": {
        "tags": ["requisitions"],
        "summary": "Update requisition (requires requisition.edit permission)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/Requisition" } }
          }
        },
        "responses": {
          "200": { "description": "Updated requisition" },
          "409": { "description": "Invalid transition" }
        }
      }
    },
    "/requisitions/{id}/transition": {
      "post": {
        "tags": ["requisitions"],
        "summary": "Transition requisition status via state machine",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": { "type": "string", "enum": ["PENDING_APPROVAL","APPROVED","OPEN","IN_REVIEW","SHORTLISTED","FILLED","CLOSED","CANCELLED"] },
                  "cancel_reason": { "type": "string", "nullable": true }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Requisition updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Requisition" } } } },
          "409": { "description": "Invalid transition", "content": { "application/json": { "schema": { "type": "object", "properties": { "error": { "type": "string", "example": "INVALID_TRANSITION" }, "from": { "type": "string" }, "to": { "type": "string" } } } } } }
        }
      }
    },
    "/requisitions/{id}/approve": {
      "post": {
        "tags": ["requisitions"],
        "summary": "Approve requisition (requires requisition.approve permission)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "Approved", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Requisition" } } } },
          "403": { "description": "Permission denied" }
        }
      }
    },
