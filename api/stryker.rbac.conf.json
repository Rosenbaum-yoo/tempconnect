{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "coverageAnalysis": "off",
  "mutate": [
    "utils/orgContext.js",
    "middleware/orgContext.js"
  ],
  "commandRunner": {
    "command": "node --test --test-force-exit test/orgContext.test.js test/rlsTenantIsolation.test.js"
  },
  "reporters": ["clear-text", "html", "json"],
  "htmlReporter": { "fileName": "reports/mutation/rbac/index.html" },
  "jsonReporter": { "fileName": "reports/mutation/rbac/mutation.json" },
  "thresholds": { "high": 85, "low": 70, "break": 0 },
  "concurrency": "50%",
  "timeoutMS": 60000,
  "incremental": false,
  "cleanTempDir": "always"
}
