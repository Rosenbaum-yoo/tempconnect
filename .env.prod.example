# ===========================================
# TempConnect – Produktion (.env.prod)
# ===========================================
# Nutzung: Auf dem Server .env.prod.example nach .env.prod kopieren,
# alle Platzhalter ersetzen, dann z.B. env_file: .env.prod oder .env.prod als .env nutzen.
# NIEMALS diese Datei mit echten Secrets committen – .env.prod ist in .gitignore!
# ===========================================

NODE_ENV=production

# ===========================================
# DATABASE – extern (z. B. Hetzner Managed PostgreSQL)
# ===========================================
# DATABASE_URL von Hetzner/Cloud-Provider verwenden – keine Container-DB in Produktion!
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
POSTGRES_DB=tempconnect
POSTGRES_USER=
POSTGRES_PASSWORD=
DB_HOST=
DB_PORT=5432

# ===========================================
# API SERVER
# ===========================================
API_PORT=3000
SESSION_SECRET=HIER_LANGEN_ZUFAELLIGEN_STRING_openssl_rand_hex_32
JWT_SECRET=HIER_LANGEN_ZUFAELLIGEN_JWT_SECRET
CORS_ORIGIN=https://deine-domain.de
BASE_URL=https://deine-domain.de
ADMIN_SECRET=HIER_ADMIN_SECRET_FUER_STATUS_ENDPOINT
LOG_LEVEL=info

# ===========================================
# E-MAIL – echte Provider (SendGrid, Brevo, etc.)
# ===========================================
# EMAIL_PROVIDER: leer = Auto-Derive (hier smtp via SMTP_HOST). Explizit setzbar:
#   smtp     = generischer SMTP-Server (Bloecke unten)
#   sendgrid = SendGrid via SMTP-Relay (smtp.sendgrid.net, user "apikey")
#   console  = nur Logging (kein Versand)  | disabled = Versand bewusst aus
# EMAIL_PROVIDER=
# Alternativ statt SMTP_PASS: SENDGRID_API_KEY setzen -> Auto-Derive auf sendgrid.
# SENDGRID_API_KEY=
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=<SendGrid-API-Key_nur_in_der_env_datei_oder_Umgebung_setzen>
SMTP_FROM=noreply@deine-domain.de

# Interner Cron (X-Internal-Secret fuer /api/internal/*)
INTERNAL_CRON_SECRET=<openssl_rand_hex_32>

# ===========================================
# PAYMENT – Stripe (echte Zahlungen)
# ===========================================
# BILLING_PROVIDER: Abrechnungsweg. stripe = Stripe-Checkout+Webhooks (STRIPE_*-Keys Pflicht);
#   manual = manuelle Rechnung; disabled = aus. Leer = Auto-Derive (stripe wenn STRIPE_SECRET_KEY).
BILLING_PROVIDER=stripe
# PAYMENT_MODE: NUR "demo" oder "live". live = echte Zahlungen (STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET Pflicht).
PAYMENT_MODE=live
# SaaS-Self-Service-Billing (Default AUS). Erst nach UG-Gruendung + Scheduler-Verdrahtung aktivieren
# (3-Schritt-Aktivierung in docs/enterprise-readiness/PILOT_CUSTOMER_RUNBOOK.md). Cron-No-Op solange false.
RECURRING_BILLING_ENABLED=false
DUNNING_ENABLED=false
# Stripe Live Keys – aus https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_DEIN_LIVE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_live_DEIN_LIVE_PUBLISHABLE_KEY
# Stripe Webhook Secret – aus https://dashboard.stripe.com/webhooks
# Webhook-Endpoint: https://deine-domain.de/api/payment/webhook/stripe
STRIPE_WEBHOOK_SECRET=whsec_DEIN_WEBHOOK_SECRET
# Redirect-URLs nach Stripe-Checkout
STRIPE_SUCCESS_URL=https://deine-domain.de/public/sla_abo.html?payment=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://deine-domain.de/public/sla_abo.html?payment=cancelled
# PayPal (optional)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live

# ===========================================
# THEME SYSTEM (Tier-2 Env-Kill-Switch)
# ===========================================
# Standard: beide AN (leer = an). Nur explizit false/0/no/off schaltet ab.
# THEME_SWITCHER_ENABLED      = Theme-Umschalter im Staff Control Center sichtbar.
# ULTRA_PREMIUM_THEME_ENABLED = "ultra_premium" als dritte Theme-Stufe waehlbar.
# Whitelabel/Abschaltung pro Instanz: auf false setzen.
# THEME_SWITCHER_ENABLED=true
# ULTRA_PREMIUM_THEME_ENABLED=true

# ===========================================
# RATE LIMITING (Scale-ready: Redis bei mehreren Instanzen)
# ===========================================
# memory = pro Instanz (Default). redis = gemeinsam hinter Load Balancer (REDIS_URL Pflicht).
# RATE_LIMIT_STORE=memory
# RATE_LIMIT_STORE=redis
# REDIS_URL=redis://:PASSWORT@redis-host:6379/0

# ===========================================
# DB POOL & SSL (Managed DB)
# ===========================================
# PGPOOL_MAX=20
# PGPOOL_IDLE_TIMEOUT_MS=30000
# PGPOOL_CONN_TIMEOUT_MS=5000
# PGSSLMODE=require

# ===========================================
# PORTS (bei Nutzung von docker-compose.ports-internal.yml)
# ===========================================
FRONTEND_PORT=8080
DB_EXTERNAL_PORT=5432

# ===========================================
# MONITORING (Sentry – empfohlen fuer Produktion)
# ===========================================
# Error-Tracking: https://sentry.io → Projects → Node.js
SENTRY_DSN=
# Performance-Tracing Sample Rate (Produktion: 0.05–0.2 empfohlen)
SENTRY_TRACES_SAMPLE_RATE=0.1

# ===========================================
# SUCHE (optional)
# ===========================================
# MEILISEARCH_URL=http://meilisearch:7700
# MEILISEARCH_API_KEY=
