# ===========================================
# TempConnect – Entwicklung (.env.dev)
# ===========================================
# Nutzung: copy .env.dev.example .env.dev (oder als .env fuer lokales Docker)
# Nur fuer lokale Entwicklung – nie auf Produktions-Server verwenden!
# ===========================================

NODE_ENV=development

# ===========================================
# DATABASE (lokaler Container)
# ===========================================
POSTGRES_DB=tempconnect
POSTGRES_USER=tempconnect
POSTGRES_PASSWORD=dev_passwort_nur_lokal
DATABASE_URL=postgres://tempconnect:dev_passwort_nur_lokal@db:5432/tempconnect
DB_HOST=
DB_PORT=5432

# ===========================================
# API SERVER
# ===========================================
API_PORT=3000
SESSION_SECRET=dev_secret_nur_lokal_aendern
JWT_SECRET=dev_jwt_secret_nur_lokal
CORS_ORIGIN=http://localhost:8080
BASE_URL=http://localhost:8080
ADMIN_SECRET=
LOG_LEVEL=debug

# ===========================================
# E-MAIL – Mailpit (lokaler Container, Profil dev)
# ===========================================
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@tempconnect.local

# ===========================================
# PORTS
# ===========================================
FRONTEND_PORT=8080
DB_EXTERNAL_PORT=5432
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ===========================================
# PAYMENT – Demo/Test
# ===========================================
PAYMENT_MODE=demo
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
