# ===========================================
# TempConnect – Entwicklung (.env.dev)
# ===========================================
# Nutzung: copy .env.dev.example .env.dev (oder als .env fuer lokales Docker)
# Nur fuer lokale Entwicklung – nie auf Produktions-Server verwenden!
# ===========================================

NODE_ENV=development

# ===========================================
# DATABASE (lokaler Container)
# ===========================================
POSTGRES_DB=tempconnect
POSTGRES_USER=tempconnect
POSTGRES_PASSWORD=dev_passwort_nur_lokal
DATABASE_URL=postgres://tempconnect:dev_passwort_nur_lokal@db:5432/tempconnect
DB_HOST=
DB_PORT=5432

# ===========================================
# API SERVER
# ===========================================
API_PORT=3000
SESSION_SECRET=dev_secret_nur_lokal_aendern
JWT_SECRET=dev_jwt_secret_nur_lokal
CORS_ORIGIN=http://localhost:8080
BASE_URL=http://localhost:8080
ADMIN_SECRET=
LOG_LEVEL=debug

# ===========================================
# E-MAIL – Mailpit (lokaler Container, Profil dev)
# ===========================================
# EMAIL_PROVIDER: leer = Auto-Derive (hier smtp via SMTP_HOST=mailpit).
#   Werte: smtp | sendgrid | console | disabled
# EMAIL_PROVIDER=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@tempconnect.local

# ===========================================
# PORTS
# ===========================================
FRONTEND_PORT=8080
DB_EXTERNAL_PORT=5432
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ===========================================
# PAYMENT – Demo/Test
# ===========================================
# BILLING_PROVIDER: leer = Auto-Derive (hier manual, da keine STRIPE_SECRET_KEY).
#   Werte: stripe | manual | disabled
# BILLING_PROVIDER=
PAYMENT_MODE=demo
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ===========================================
# THEME SYSTEM (Tier-2 Env-Kill-Switch)
# ===========================================
# Beide AN per Default (leer = an). Lokal alle Themes testbar; zum Abschalten auf false.
#   Werte: true | false | 1 | 0 | yes | no | on | off
# THEME_SWITCHER_ENABLED=true
# ULTRA_PREMIUM_THEME_ENABLED=true

# ===========================================
# MONITORING (optional, auch lokal testbar)
# ===========================================
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=1.0
