# =============================================================================
# TempConnect — .gitignore
# =============================================================================

# Environment / Secrets — NIEMALS committen
.env
.env.local
.env.*.local
.env.dev
.env.prod
*.env
!*.env.example
!.env.example
!.env.prod.example
!.env.dev.example

# Dependencies — Docker macht npm ci
node_modules/
**/node_modules/

# Logs
*.log
npm-debug.log*
*.pid

# OS-/Editor-Artefakte (maschinenspezifisch, nie committen)
*.lnk

# Builds / Coverage / Test-Artefakte
dist/
build/
coverage/
**/coverage/
.c8_output/
**/.c8_output/
.nyc_output/
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.swp
*.swo
*.bak
*.tmp

# Warp (Agent-Skills etc. — lokal)
.warp/

# Agenten / Claude Code / lokale AI-Workspaces
# .claude/ ist NICHT mehr komplett ignoriert: Lern-Tooling wird versioniert
# (commands/, hooks/, settings.json, learning/config.md + applied_log.md).
# Volatile Lern-Dateien + lokale Workspaces (settings.local.json, worktrees/) bleiben ignoriert.
.claude/*
!.claude/commands/
!.claude/hooks/
!.claude/settings.json
!.claude/learning/
.claude/learning/insights_inbox.md
.claude/learning/proposals.md
.agents/
.claire/
.clone/

# Release-Artefakte und ZIP-Analysen
_zip_analysis/

# Persoenliche Claude-Code Arbeits-/Planungsnotizen (kein Release-Artefakt;
# dauerhafte Wahrheit lebt in docs/design/EDITORIAL_THEME_ROLLOUT.md)
/_TEMPCONNECT_*

# Kryptographische Schlüssel (niemals committen)
*.pem
*.key
private_key
private_key.*

# Docker
docker-compose.override.yml

# Database
*.sql.backup
*.dump

# Persistent data volumes — niemals committen
/data/
/db-data/
/redis-data/
/backups/

# Uploads / temp — niemals committen
uploads/
tmp/
**/uploads/
**/tmp/

# Release / Deployment artifacts
*.tar.gz
*.zip
release/
.vercel
.env*.local

# OCC React Build-Output (Vite generiert, nicht committen)
# Vite-Build-Ergebnisse. Der Produktions-Stack erzeugt sie beim Deploy selbst
# (docker-compose.prod.yml, Dienst `frontend-build`: npm ci + build:occ + build:scc),
# und `emptyOutDir: true` loescht das Zielverzeichnis dabei vollstaendig — nachgewiesen
# am 2026-07-26: ein Lauf ersetzte alle 31 Bundles und entfernte 27 getrackte Dateien.
# Getrackte Kopien ueberleben also keinen Deploy; sie erzeugen nur Diff-Laerm und
# Merge-Konflikte. Nach einem frischen Klon: `npm run build:occ && npm run build:scc`
# (bzw. build:soc) im Ordner frontend/.
frontend/owner-control/
frontend/public/staff/
frontend/support-ops/

# AUSNAHME: support-ops-dist wird bewusst vorgebaut ausgeliefert — der Prod-Stack mountet
# es direkt (kein Build-Schritt dafuer), und die CI prueft die Datei als Pflichtbestandteil
# des Release-Artefakts. Sie gehoert deshalb ins Repo.
support-ops-dist/*
!support-ops-dist/index.html

# Falsch benannte Env-Datei (enthaelt Secrets) — niemals committen
.env.txt
*.env.txt

# Test-Runner-Output (Playwright etc.)
test-results/

# Versehentlich abgelegte Datei
openai-1.pdf
