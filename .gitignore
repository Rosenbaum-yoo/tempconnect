# =============================================================================
# TempConnect — .gitignore
# =============================================================================

# Environment / Secrets — NIEMALS committen
.env
.env.local
.env.*.local
.env.dev
.env.prod
*.env
!*.env.example
!.env.example
!.env.prod.example
!.env.dev.example

# Dependencies — Docker macht npm ci
node_modules/
**/node_modules/

# Logs
*.log
npm-debug.log*
*.pid

# Builds / Coverage / Test-Artefakte
dist/
build/
coverage/
**/coverage/
.c8_output/
**/.c8_output/
.nyc_output/
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.swp
*.swo
*.bak
*.tmp

# Warp (Agent-Skills etc. — lokal)
.warp/

# Agenten / Claude Code / lokale AI-Workspaces
# .claude/ ist NICHT mehr komplett ignoriert: Lern-Tooling wird versioniert
# (commands/, hooks/, settings.json, learning/config.md + applied_log.md).
# Volatile Lern-Dateien + lokale Workspaces (settings.local.json, worktrees/) bleiben ignoriert.
.claude/*
!.claude/commands/
!.claude/hooks/
!.claude/settings.json
!.claude/learning/
.claude/learning/insights_inbox.md
.claude/learning/proposals.md
.agents/
.claire/
.clone/

# Release-Artefakte und ZIP-Analysen
_zip_analysis/

# Kryptographische Schlüssel (niemals committen)
*.pem
*.key
private_key
private_key.*

# Docker
docker-compose.override.yml

# Database
*.sql.backup
*.dump

# Persistent data volumes — niemals committen
/data/
/db-data/
/redis-data/
/backups/

# Uploads / temp — niemals committen
uploads/
tmp/
**/uploads/
**/tmp/

# Release / Deployment artifacts
*.tar.gz
*.zip
release/
.vercel
.env*.local

# OCC React Build-Output (Vite generiert, nicht committen)
frontend/owner-control/
support-ops-dist/*
!support-ops-dist/index.html

# Falsch benannte Env-Datei (enthaelt Secrets) — niemals committen
.env.txt
*.env.txt

# Test-Runner-Output (Playwright etc.)
test-results/

# Versehentlich abgelegte Datei
openai-1.pdf
