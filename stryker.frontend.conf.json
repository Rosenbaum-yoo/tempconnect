{
  "$schema": "./api/node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "coverageAnalysis": "off",
  "mutate": [
    "frontend/public/js/hubVisibility.js"
  ],
  "commandRunner": {
    "command": "node --test --test-force-exit api/test/hubVisibility.test.js api/test/hubVisibilityIntegration.test.js api/test/visibilityMatrix.test.js"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.git/**",
    "**/.stryker-tmp/**",
    "**/reports/**",
    "**/uploads/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "**/owner-control/**",
    "**/support-ops/**",
    "**/*.pdf",
    "**/*.docx",
    "**/*.png",
    "**/*.jpg",
    "**/*.css",
    "**/*.md",
    "**/*.sql",
    "**/e2e/**",
    "**/frontend/src/**"
  ],
  "reporters": [
    "clear-text",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/frontend/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/frontend/mutation.json"
  },
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 0
  },
  "concurrency": "50%",
  "timeoutMS": 60000,
  "incremental": false,
  "cleanTempDir": "always",
  "disableTypeChecks": false
}
