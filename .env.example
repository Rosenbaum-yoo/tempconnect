# ===========================================
# TempConnect - Konfigurationsdatei
# ===========================================
# ANLEITUNG:
# 1. Kopiere diese Datei nach .env: copy .env.example .env
# 2. Passe die Werte in .env an
# 3. Fuer Produktion: Alle Passwoerter/Secrets aendern!
# ===========================================

NODE_ENV=development  # development | production

# ===========================================
# DATABASE
# ===========================================
# Entweder DATABASE_URL (empfohlen, z. B. Hetzner Managed DB) ODER DB_HOST + POSTGRES_*
POSTGRES_DB=tempconnect
POSTGRES_USER=tempconnect
POSTGRES_PASSWORD=HIER_SICHERES_PASSWORT
DATABASE_URL=postgres://tempconnect:HIER_SICHERES_PASSWORT@db:5432/tempconnect
# Optional, wenn keine DATABASE_URL: DB_HOST=db DB_PORT=5432
DB_HOST=
DB_PORT=5432
# Pool-Tuning (viele Kunden / Managed DB): PGPOOL_MAX=20 PGPOOL_IDLE_TIMEOUT_MS=30000
# PGPOOL_MAX=
# PGPOOL_IDLE_TIMEOUT_MS=30000

# ===========================================
# API SERVER
# ===========================================
# In Produktion PFLICHT (sonst startet API nicht): SESSION_SECRET + JWT_SECRET sicher setzen (nicht Default!)
API_PORT=3000
SESSION_SECRET=HIER_LANGEN_ZUFAELLIGEN_STRING_SETZEN
# JWT (z. B. fuer Tokens): nie im Code hart codieren, immer aus .env; in Produktion Pflicht
JWT_SECRET=superlangundzufaellig
CORS_ORIGIN=https://deine-domain.de
BASE_URL=https://deine-domain.de
# Admin-Status (DB + Migrationen): Header X-Admin-Secret oder ?secret=...
ADMIN_SECRET=
# Optional: Logging + Rate-Limits
LOG_LEVEL=info
# RATE_LIMIT_STORE=memory
# RATE_LIMIT_STORE=redis  → dann REDIS_URL setzen (Pflicht), sonst process.exit(1)
# REDIS_URL=redis://:PASSWORT@host:6379/0
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX=5
# RATE_LIMIT_API_WINDOW_MS=300000
# RATE_LIMIT_API_MAX=200

# ===========================================
# E-MAIL PROVIDER
# ===========================================
# Waehle EINEN Provider und trage die Daten ein.
# Loesche oder kommentiere die anderen aus.
#
# WICHTIG: Nur die aktiven Zeilen (ohne #) werden verwendet!

# ------------------------------------------
# LOKAL: Mailpit (nur fuer Entwicklung)
# ------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@tempconnect.local

# ------------------------------------------
# GMAIL
# ------------------------------------------
# Anleitung:
# 1. Google Account -> Sicherheit -> 2FA aktivieren
# 2. App-Passwort erstellen: https://myaccount.google.com/apppasswords
# 3. App-Passwort (16 Zeichen) hier eintragen
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=deine-email@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# SMTP_FROM=deine-email@gmail.com

# ------------------------------------------
# OUTLOOK / OFFICE 365 / HOTMAIL
# ------------------------------------------
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=deine-email@outlook.com
# SMTP_PASS=dein-passwort
# SMTP_FROM=deine-email@outlook.com

# ------------------------------------------
# SENDGRID (empfohlen fuer Produktion)
# ------------------------------------------
# Anleitung:
# 1. Account: https://sendgrid.com (kostenlos bis 100 Mails/Tag)
# 2. API Key: Settings -> API Keys -> Create API Key
# 3. Sender: Settings -> Sender Authentication
#
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=<DEIN_SENDGRID_API_KEY_NUR_IN_der_env_datei_setzen>
# SMTP_FROM=noreply@deine-domain.de

# ------------------------------------------
# MAILGUN
# ------------------------------------------
# Anleitung:
# 1. Account: https://mailgun.com
# 2. Domain verifizieren
# 3. SMTP Credentials: Sending -> Domain -> SMTP credentials
#
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=postmaster@mg.deine-domain.de
# SMTP_PASS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SMTP_FROM=noreply@deine-domain.de

# ------------------------------------------
# AMAZON SES
# ------------------------------------------
# Anleitung:
# 1. AWS Console -> SES
# 2. Domain/E-Mail verifizieren
# 3. SMTP Credentials erstellen
# Region: eu-central-1 = Frankfurt, eu-west-1 = Irland
#
# SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=AKIAXXXXXXXXXXXX
# SMTP_PASS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SMTP_FROM=noreply@deine-domain.de

# ------------------------------------------
# BREVO (ehemals Sendinblue)
# ------------------------------------------
# Anleitung:
# 1. Account: https://brevo.com (kostenlos bis 300 Mails/Tag)
# 2. SMTP & API -> SMTP-Zugangsdaten
#
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=deine-email@domain.de
# SMTP_PASS=xsmtpsib-xxxxxxxxxxxxxxxxxxxxxxxx
# SMTP_FROM=noreply@deine-domain.de

# ------------------------------------------
# POSTMARK
# ------------------------------------------
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=dein-server-api-token
# SMTP_PASS=dein-server-api-token
# SMTP_FROM=noreply@deine-domain.de

# ------------------------------------------
# IONOS / 1&1
# ------------------------------------------
# SMTP_HOST=smtp.ionos.de
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=deine-email@deine-domain.de
# SMTP_PASS=dein-passwort
# SMTP_FROM=deine-email@deine-domain.de

# ------------------------------------------
# STRATO
# ------------------------------------------
# SMTP_HOST=smtp.strato.de
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=deine-email@deine-domain.de
# SMTP_PASS=dein-passwort
# SMTP_FROM=deine-email@deine-domain.de

# ===========================================
# PORTS (nur lokal)
# ===========================================
FRONTEND_PORT=8080
API_EXTERNAL_PORT=3000
DB_EXTERNAL_PORT=5432
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ===========================================
# PAYMENT - STRIPE
# ===========================================
# Anleitung:
# 1. Account: https://dashboard.stripe.com/register
# 2. API Keys: https://dashboard.stripe.com/apikeys
#    Test-Keys: sk_test_... / pk_test_...
#    Live-Keys: sk_live_... / pk_live_...
# 3. Webhook: https://dashboard.stripe.com/webhooks
#    URL: https://deine-domain.de/api/payment/webhook/stripe
#    Events: checkout.session.completed
#
STRIPE_SECRET_KEY=<NUR_IN_der_env_setzen_sk_test_oder_sk_live>
STRIPE_PUBLISHABLE_KEY=<pk_test_oder_pk_live>
STRIPE_WEBHOOK_SECRET=<whsec_...>

# Interner Cron (expire-reservations, sla-scan, etc.): Header X-Internal-Secret
INTERNAL_CRON_SECRET=<Langer_zufaelliger_String_openssl_rand_hex_32>

# ===========================================
# PAYMENT - PAYPAL (optional)
# ===========================================
# 1. Developer: https://developer.paypal.com
# 2. App erstellen: Dashboard -> Apps & Credentials
#
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox  # sandbox | live

# ===========================================
# PAYMENT MODE
# ===========================================
# demo = Testzahlungen (Entwicklung)
# live = Echte Zahlungen (Produktion)
PAYMENT_MODE=demo
