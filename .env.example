# ===========================================
# TempConnect - Konfigurationsdatei
# ===========================================
# ANLEITUNG:
# 1. Kopiere diese Datei nach .env: copy .env.example .env
# 2. Passe die Werte in .env an
# 3. Fuer Produktion: Alle Passwoerter/Secrets aendern!
# ===========================================

NODE_ENV=development  # development | production

# ===========================================
# DATABASE
# ===========================================
# Entweder DATABASE_URL (empfohlen, z. B. Hetzner Managed DB) ODER DB_HOST + POSTGRES_*
POSTGRES_DB=tempconnect
POSTGRES_USER=tempconnect
POSTGRES_PASSWORD=HIER_SICHERES_PASSWORT
DATABASE_URL=postgres://tempconnect:HIER_SICHERES_PASSWORT@db:5432/tempconnect
# Optional, wenn keine DATABASE_URL: DB_HOST=db DB_PORT=5432
DB_HOST=
DB_PORT=5432
# Pool-Tuning (viele Kunden / Managed DB): PGPOOL_MAX=20 PGPOOL_IDLE_TIMEOUT_MS=30000
# PGPOOL_MAX=
# PGPOOL_IDLE_TIMEOUT_MS=30000

# ===========================================
# API SERVER
# ===========================================
# In Produktion PFLICHT (sonst startet API nicht): SESSION_SECRET + JWT_SECRET sicher setzen (nicht Default!)
API_PORT=3000
SESSION_SECRET=HIER_LANGEN_ZUFAELLIGEN_STRING_SETZEN
# JWT (z. B. fuer Tokens): nie im Code hart codieren, immer aus .env; in Produktion Pflicht
JWT_SECRET=<HIER_LANGEN_ZUFAELLIGEN_STRING_SETZEN>
CORS_ORIGIN=https://deine-domain.de
BASE_URL=https://deine-domain.de
# Admin-Status (DB + Migrationen): Header X-Admin-Secret oder ?secret=...
ADMIN_SECRET=
# Nur fuer interne Tests: true = jeder eingeloggte User darf Admin-Panel-API nutzen. In Produktion immer false.
ADMIN_PANEL_OPEN=false
# Optional: Logging + Rate-Limits
LOG_LEVEL=info
# RATE_LIMIT_STORE=memory
# RATE_LIMIT_STORE=redis  → dann REDIS_URL setzen (Pflicht), sonst process.exit(1)
# REDIS_URL=redis://:PASSWORT@host:6379/0
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX=5
# RATE_LIMIT_API_WINDOW_MS=300000
# RATE_LIMIT_API_MAX=200
# RATE_LIMIT_OCC_WINDOW_MS=60000
# RATE_LIMIT_OCC_MAX=60
# RATE_LIMIT_SUPPORT_WINDOW_MS=60000
# RATE_LIMIT_SUPPORT_MAX=90
# RATE_LIMIT_WARP_EXEC_WINDOW_MS=3600000
# RATE_LIMIT_WARP_EXEC_MAX=10
# SUPPORT_OPS_ENABLED=true
# Warp SSH-Runbook-Ausführung (OCC /owner-control/warp/*)
# WARP_SSH_ENABLED=false
# WARP_SSH_USER=deploy
# WARP_SSH_PORT=22
# WARP_SSH_KEY_PATH=/run/secrets/warp_ssh_key
# WARP_SSH_CONNECT_TIMEOUT_MS=15000
# WARP_SSH_COMMAND_TIMEOUT_MS=120000
# WARP_SSH_STRICT_HOST_KEY_CHECKING=accept-new
# WARP_REMOTE_APP_DIR=/opt/tempconnect
# WARP_REMOTE_HEALTH_URL=http://127.0.0.1:8080/health
# Infrastruktur-Snapshot-Ingest (POST /api/internal/infrastructure-snapshots/ingest)
# INFRA_SNAPSHOT_INGEST_ENABLED=true
# INFRA_SNAPSHOT_MAX_BATCH=50

# ===========================================
# STAFF CONTROL CENTER (SCC) — Go-Live-Ops (P1.0)
# ===========================================
# Separate Betreiber-Konsole unter /staff. Strikt getrennt von Abo-Kunden,
# Admin-Panel und OCC (eigene Session-Welt).
# STAFF_SESSION_SECRET: eigenes Session-Secret fuer die Staff-Welt. In PRODUKTION
#   PFLICHT (>= 32 zufaellige Bytes, kein Platzhalter) — sonst Startabbruch
#   (api/config/index.js). Ohne Wert leitet Dev aus SESSION_SECRET + ":staff" ab.
# STAFF_USER_IDS: Komma-separierte User-UUIDs, die EINMALIG als Staff gebootstrappt
#   werden (z. B. Elmira + Mitarbeiter). Danach via SCC-Verwaltung pflegbar.
# HETZNER_CLOUD_TOKEN: optional. Ohne Token laeuft die Infra-GUI im Stub-Mode
#   (deterministische Mock-Daten, kein Live-Infra-Zugriff).
# STAFF_SESSION_SECRET=<openssl rand -hex 32>
# STAFF_USER_IDS=<uuid-1>,<uuid-2>
# HETZNER_CLOUD_TOKEN=

# ===========================================
# E-MAIL PROVIDER
# ===========================================
# Waehle EINEN Provider und trage die Daten ein.
# Loesche oder kommentiere die anderen aus.
#
# WICHTIG: Nur die aktiven Zeilen (ohne #) werden verwendet!

# ------------------------------------------
# PROVIDER-AUSWAHL (Phase E, optional)
# ------------------------------------------
# EMAIL_PROVIDER steuert den Versandweg explizit. Leer = automatische Ableitung:
#   SENDGRID_API_KEY gesetzt -> sendgrid ; sonst SMTP_HOST gesetzt -> smtp ; sonst console (nur Logging).
#   smtp     = generischer SMTP-Server (Bloecke unten)
#   sendgrid = SendGrid via SMTP-Relay (smtp.sendgrid.net, user "apikey"; KEINE neue Dependency)
#   console  = E-Mails werden nur geloggt, nicht gesendet (Dev-Default)
#   disabled = Versand bewusst aus (z. B. Demo-/Pilot-Instanz)
# EMAIL_PROVIDER=
# SENDGRID_API_KEY=

# ------------------------------------------
# LOKAL: Mailpit (nur fuer Entwicklung)
# ------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@tempconnect.local

# ------------------------------------------
# GMAIL
# ------------------------------------------
# Anleitung:
# 1. Google Account -> Sicherheit -> 2FA aktivieren
# 2. App-Passwort erstellen: https://myaccount.google.com/apppasswords
# 3. App-Passwort (16 Zeichen) hier eintragen
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=deine-email@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# SMTP_FROM=deine-email@gmail.com

# ------------------------------------------
# OUTLOOK / OFFICE 365 / HOTMAIL
# ------------------------------------------
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=deine-email@outlook.com
# SMTP_PASS=dein-passwort
# SMTP_FROM=deine-email@outlook.com

# ------------------------------------------
# SENDGRID (empfohlen fuer Produktion)
# ------------------------------------------
# Anleitung:
# 1. Account: https://sendgrid.com (kostenlos bis 100 Mails/Tag)
# 2. API Key: Settings -> API Keys -> Create API Key
# 3. Sender: Settings -> Sender Authentication
#
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=<DEIN_SENDGRID_API_KEY_NUR_IN_der_env_datei_setzen>
# SMTP_FROM=noreply@deine-domain.de

# ------------------------------------------
# MAILGUN
# ------------------------------------------
# Anleitung:
# 1. Account: https://mailgun.com
# 2. Domain verifizieren
# 3. SMTP Credentials: Sending -> Domain -> SMTP credentials
#
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=postmaster@mg.deine-domain.de
# SMTP_PASS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SMTP_FROM=noreply@deine-domain.de

# ------------------------------------------
# AMAZON SES
# ------------------------------------------
# Anleitung:
# 1. AWS Console -> SES
# 2. Domain/E-Mail verifizieren
# 3. SMTP Credentials erstellen
# Region: eu-central-1 = Frankfurt, eu-west-1 = Irland
#
# SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=AKIAXXXXXXXXXXXX
# SMTP_PASS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SMTP_FROM=noreply@deine-domain.de

# ------------------------------------------
# BREVO (ehemals Sendinblue)
# ------------------------------------------
# Anleitung:
# 1. Account: https://brevo.com (kostenlos bis 300 Mails/Tag)
# 2. SMTP & API -> SMTP-Zugangsdaten
#
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=deine-email@domain.de
# SMTP_PASS=xsmtpsib-xxxxxxxxxxxxxxxxxxxxxxxx
# SMTP_FROM=noreply@deine-domain.de

# ------------------------------------------
# POSTMARK
# ------------------------------------------
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=dein-server-api-token
# SMTP_PASS=dein-server-api-token
# SMTP_FROM=noreply@deine-domain.de

# ------------------------------------------
# IONOS / 1&1
# ------------------------------------------
# SMTP_HOST=smtp.ionos.de
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=deine-email@deine-domain.de
# SMTP_PASS=dein-passwort
# SMTP_FROM=deine-email@deine-domain.de

# ------------------------------------------
# STRATO
# ------------------------------------------
# SMTP_HOST=smtp.strato.de
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=deine-email@deine-domain.de
# SMTP_PASS=dein-passwort
# SMTP_FROM=deine-email@deine-domain.de

# ===========================================
# PORTS (nur lokal)
# ===========================================
FRONTEND_PORT=8080
API_EXTERNAL_PORT=3000
DB_EXTERNAL_PORT=5432
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ===========================================
# PAYMENT - STRIPE
# ===========================================
# Anleitung:
# 1. Account: https://dashboard.stripe.com/register
# 2. API Keys: https://dashboard.stripe.com/apikeys
#    Test-Keys: sk_test_... / pk_test_...
#    Live-Keys: sk_live_... / pk_live_...
# 3. Webhook: https://dashboard.stripe.com/webhooks
#    URL: https://deine-domain.de/api/payment/webhook/stripe
#    Events: checkout.session.completed
#
STRIPE_SECRET_KEY=<NUR_IN_der_env_setzen_sk_test_oder_sk_live>
STRIPE_PUBLISHABLE_KEY=<pk_test_oder_pk_live>
STRIPE_WEBHOOK_SECRET=<whsec_...>
# Redirect-URLs nach Stripe-Checkout (optional)
# STRIPE_SUCCESS_URL=https://deine-domain.de/public/sla_abo.html?payment=success&session_id={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=https://deine-domain.de/public/sla_abo.html?payment=cancelled

# Interner Cron (expire-reservations, sla-scan, etc.): Header X-Internal-Secret
INTERNAL_CRON_SECRET=<Langer_zufaelliger_String_openssl_rand_hex_32>

# ===========================================
# PAYMENT - PAYPAL (optional)
# ===========================================
# 1. Developer: https://developer.paypal.com
# 2. App erstellen: Dashboard -> Apps & Credentials
#
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox  # sandbox | live

# ===========================================
# PAYMENT MODE / BILLING PROVIDER
# ===========================================
# BILLING_PROVIDER steuert den Abrechnungsweg explizit. Leer = automatische Ableitung:
#   STRIPE_SECRET_KEY gesetzt -> stripe ; sonst manual (Rechnung manuell).
#   stripe   = Stripe-Checkout + Webhooks (STRIPE_*-Keys Pflicht)
#   manual   = manuelle Rechnungsstellung (Default ohne Stripe-Keys)
#   disabled = Abrechnung bewusst aus (z. B. Demo-/Pilot-Instanz)
# BILLING_PROVIDER=
#
# PAYMENT_MODE:
# demo = Testzahlungen (Entwicklung)
# live = Echte Zahlungen (Produktion) – STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET muessen gesetzt sein!
PAYMENT_MODE=demo

# SaaS-Self-Service-Billing (Default AUS — kein Auto-Billing solange manuelle Rechnung Default ist).
# Erst bei UG-Gruendung aktivieren (siehe docs/enterprise-readiness/PILOT_CUSTOMER_RUNBOOK.md):
#   true -> Cron /internal/recurring-billing erzeugt Folge-Rechnungen am Periodenende.
RECURRING_BILLING_ENABLED=false
#   true -> Cron /internal/dunning-sweep versendet gestaffelte Zahlungserinnerungen.
DUNNING_ENABLED=false

# M2M-Auth (OIDC client_credentials) — externe Systeme (SAP/HR) tauschen ihren API-Key an
# /api/oauth/token gegen ein kurzlebiges Bearer-JWT. Default AUS (neue Auth-Oberflaeche inert).
#   true -> /api/oauth/token aktiv + M2M-JWTs werden als Bearer akzeptiert (HS256 via JWT_SECRET).
OAUTH_M2M_ENABLED=false

# SCIM 2.0 Provisioning (/api/scim/v2/*) — ein HR-/IdP-System legt Nutzer in der EIGENEN Org an
# bzw. deaktiviert sie. Default AUS. Auth via API-Key/M2M-Token mit Scope admin:scim.
SCIM_ENABLED=false

# ===========================================
# FEATURE GATES
# ===========================================
# true = Alle Features freigeschaltet (Entwicklung/Demo)
# false = Plan-basierte Feature-Gates aktiv (Produktion) ← PROD-DEFAULT
# true  = alle Features fuer alle Plaene aktiv (nur lokal, nie in Prod)
# Lokal ueberschreiben: eigene .env mit FEATURE_GATE_BYPASS=true (nicht committen!)
FEATURE_GATE_BYPASS=false

# ===========================================
# DEMO-SEED-WELT (Migration 052) — Tier-2 Build-Schalter
# ===========================================
# Steuert, ob die Demo-Welt (Migration 052: 6 Demo-Konten, 5 Orgs, volles
# Szenario) beim Migrate angelegt wird. Wird vom migrate-Service gelesen
# (migrate.sh -> PGOPTIONS app.seed_demo_world), NICHT von der API.
#   false (Default) = prod-sicher, KEINE Demo-Konten. PFLICHT in Produktion.
#   true            = Demo-Welt seeden (nur Dev/Sales; lokal via
#                     docker-compose.override.yml automatisch true).
# WARNUNG: true in Prod legt 6 Konten mit OEFFENTLICH bekanntem Passwort an
# (Login-Backdoor). docker-compose.prod.yml pinnt den Wert daher hart auf false.
# Bestands-DBs, die das frueher ungegatete 052 liefen, werden von Migration 125
# neutralisiert (Passwort-Login der Demo-Konten gesperrt).
SEED_DEMO_WORLD=false

# ===========================================
# THEME SYSTEM (Phase J, Tier-2 Env-Kill-Switch)
# ===========================================
# Standard: beide AN (leer/ungesetzt = an). Nur explizit false/0/no/off schaltet ab.
# THEME_SWITCHER_ENABLED      = Theme-Umschalter im Staff Control Center sichtbar.
# ULTRA_PREMIUM_THEME_ENABLED = "ultra_premium" als dritte Theme-Stufe waehlbar.
# Zum Abschalten auf false setzen, z. B. ULTRA_PREMIUM_THEME_ENABLED=false
# THEME_SWITCHER_ENABLED=true
# ULTRA_PREMIUM_THEME_ENABLED=true

# ===========================================
# MFA ENFORCEMENT (O-05, Tier-2 Env-Kill-Switch)
# ===========================================
# Standard: AUS = Audit-Only (mfaGuard loggt, blockiert NICHT). Owner-Flip fuer den
# scharfen Modus auf den env-gesteuerten Plattform-Surfaces (OCC, payment, settings):
#   MFA_ENFORCE=true
# Optionale Enrollment-Frist (Grace-Period): bis zu diesem ISO-Datum bleibt es trotz
# MFA_ENFORCE=true im Audit-Only — Zeit fuer Nutzer, MFA einzurichten. Ein gesetztes,
# aber unparsierbares Datum bleibt fail-safe im Audit-Only (kein versehentl. Hart-Enforce):
#   MFA_ENFORCE_FROM=2026-09-01
# Kein Lockout: Enrollment-Endpunkte (/api/mfa/setup|enable|verify) sind NIE MFA-gated
# (Plattform-Session/userId). Das SCC (Staff-Session, eigenes Cookie, KEIN /mfa/*-Pfad)
# ist BEWUSST ausgenommen und bleibt Audit-Only — es nutzt stattdessen Step-up.
# MFA_ENFORCE=false
# MFA_ENFORCE_FROM=

# ===========================================
# MONITORING (optional)
# ===========================================
# Prometheus — Metrics-Endpoint-Secret
# Muss dem ADMIN_SECRET der API entsprechen, damit Prometheus /metrics abrufen kann.
# Wird von docker-compose.monitoring.yml in prometheus.yml substituiert (via start-prometheus.sh).
# Pflicht wenn docker-compose.monitoring.yml aktiv ist — sonst bleibt Monitoring tot.
PROMETHEUS_METRICS_SECRET=

# Sentry (Error-Tracking): https://sentry.io
# 1. Projekt erstellen unter https://sentry.io → Projects → Create Project → Node.js
# 2. DSN kopieren und hier eintragen
# Ohne SENTRY_DSN: Monitoring ist deaktiviert (kein Fehler, keine Abhaengigkeit)
SENTRY_DSN=
# Anteil der Requests fuer Performance-Tracing (0.0 = aus, 1.0 = alle)
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ===========================================
# SUCHE (optional)
# ===========================================
# Meilisearch (Volltextsuche): https://meilisearch.com
# MEILISEARCH_URL=http://meilisearch:7700
# MEILISEARCH_API_KEY=
